# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# `production` liga duas travas: o Swagger sai do ar (veja SWAGGER_ATIVO) e a
# aplicação recusa subir com o JWT_SECRET de exemplo abaixo.
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Origens liberadas no CORS (separadas por vírgula).
# Em produção, liste o domínio do SITE — não o da API. É o navegador do
# visitante que é barrado, e ele se identifica pela origem da página aberta.
#   CORS_ORIGINS=https://procertocp.com.br,https://www.procertocp.com.br
CORS_ORIGINS=http://localhost:5173

# Documentação interativa em /api/docs. Sem esta variável, segue a regra:
# ligada fora de produção, desligada em produção. Ela é um mapa completo da API
# servido sem autenticação — só ligue num ambiente publicado se souber por quê.
# SWAGGER_ATIVO=false

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ---------------------------------------------------------------------------
# Porta 5433, e não 5432: o container é mapeado 5433:5432 para conviver com uma
# instalação nativa de PostgreSQL na máquina. Com 5432 aqui, o primeiro comando
# do guia falha com `P1000: Authentication failed`.
DATABASE_URL="postgresql://procert:procert@localhost:5433/procert?schema=public"

# Só produção, e só no BUILD. Em serverless a DATABASE_URL aponta para o
# transaction pooler (:6543), que o `prisma migrate` não aceita — ele precisa de
# advisory lock, e o pgbouncer em modo transação não o mantém entre statements.
# `prisma/migrar-no-deploy.js` prefere esta quando existe. Em desenvolvimento não
# há dois poolers, então deixe vazia: a DATABASE_URL acima já serve.
MIGRATE_DATABASE_URL=

# Guarda de migration pendente no boot, ativa só com NODE_ENV=development.
#
# Um `git pull` traz migrations e não dispara nada: o banco local fica atrás do
# código e a API subiria normalmente, até a primeira query tocar uma coluna que
# ainda não existe — e o `P2022` acusa o código, que está certo. Com a guarda, a
# API recusa subir e diz para rodar `npm run setup`.
#
# `false` desliga. Existe para quem precisar subir assim mesmo, conscientemente;
# guarda sem contorno é guarda que alguém arranca no primeiro aperto.
CHECAR_MIGRATIONS=true

# ---------------------------------------------------------------------------
# Autenticação
# Gere um segredo forte:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Onde os arquivos enviados ficam: `disco` (padrão) ou `supabase`.
#
# `disco` grava em UPLOAD_DIR e o Nest serve as pastas públicas como estático —
# é o comportamento de sempre, e o correto num servidor com disco persistente.
#
# `supabase` existe para ambiente serverless (Vercel), onde o filesystem é
# efêmero e recriado a cada instância fria: um PDF de certificado gravado em
# disco some sem erro nenhum, e o registro no banco fica apontando para um
# arquivo que não existe mais. A URL guardada no banco continua sendo
# `/uploads/<pasta>/<arquivo>` nos dois casos — com `supabase`, essa rota
# responde 302 para o bucket público.
UPLOAD_DRIVER=disco
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5
# URL pública onde os arquivos são servidos
PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase Storage (somente com UPLOAD_DRIVER=supabase)
# ---------------------------------------------------------------------------
# Faltando URL ou chave, a API RECUSA subir — degradar para o disco num
# ambiente efêmero seria perder arquivo em silêncio.
#
# A chave é a `service_role`: ela ignora RLS e vale como credencial de
# administrador do projeto. Fica só no servidor, NUNCA no frontend.
#
# Dois buckets, espelhando PASTAS_PUBLICAS × PASTAS_PRIVADAS:
#  • público  — leitura anônima ligada; recebe clientes/, funcionarios/,
#               produtos/ e aparencia/, que o navegador busca sem Bearer.
#  • privado  — leitura anônima DESLIGADA; recebe certificados/ e
#               certificacoes/, que só saem por GET /certificados/:id/pdf e
#               GET /certificacoes/documentos/:id/arquivo, com posse conferida.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PUBLICO=procert-publico
SUPABASE_BUCKET_PRIVADO=procert-privado

# ---------------------------------------------------------------------------
# Rotinas agendadas
# ---------------------------------------------------------------------------
# Expiração automática de certificados: todo dia às 03:00, marca como VENCIDO o
# que passou da validade. Ligada por padrão — uma instalação nova não deve
# exibir certificado vencido como se ainda valesse.
#
# Rodando a API em MAIS DE UMA instância, o job dispara em todas. É um
# `updateMany` idempotente, então não corrompe nada, mas deixe `true` em
# exatamente uma instância para não multiplicar conexão e log.
#
# A rota POST /certificados/expirar-vencidos continua disponível para
# acionamento manual, independentemente deste valor.
EXPIRACAO_CRON_ATIVA=true

# Gatilho externo da mesma rotina, para hospedagem SERVERLESS.
#
# Em função não existe processo entre duas requisições: o timer do
# `@nestjs/schedule` é criado no boot e morre com a instância, sem nunca chegar
# às 03:00. Por isso, na Vercel, EXPIRACAO_CRON_ATIVA=false e quem acorda a
# rotina é o Vercel Cron (declarado em `vercel.json`), chamando
# GET /api/certificados/cron/expirar-vencidos com este segredo no Bearer.
#
# NÃO é um token de sessão: não vira usuário, não passa pelo RolesGuard e abre
# uma única porta, que faz um updateMany idempotente derivado da data. Vazado, o
# estrago possível é disparar hoje o que ia rodar de madrugada.
#
# Vazio (o padrão) = rota FECHADA. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# E-mail (SMTP) — redefinição de senha e aviso de atualização da certificação
# ---------------------------------------------------------------------------
# Vazios (o padrão) = os e-mails são apenas registrados no log. É o
# comportamento desejado em desenvolvimento; em produção o boot acusa em
# `error`, porque lá a ausência é a funcionalidade inteira faltando.
#
# O provedor é o Resend. `smtp.hostinger.com` esteve aqui por herança do
# legado e nunca foi exercitado — o domínio nem usa Hostinger (o MX de
# procertocp.com.br aponta para o Microsoft 365). Como nenhum e-mail saiu de
# produção até 03/09/2026, o valor errado nunca deu erro para ninguém ver.
#
# No Resend o usuário é a palavra literal `resend`; a senha é a API key.
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM="ProCert <nao-responda@procertocp.com.br>"
# Base dos links de e-mail e do rodapé do PDF do certificado. Faltando,
# `urlDoPainel()` deriva de CORS_ORIGINS em vez de cair no localhost.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# ETL — conexão com o MySQL legado (somente para `npm run migrate:legacy`)
# ---------------------------------------------------------------------------
LEGACY_MYSQL_HOST=
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_DATABASE=
# Senha provisória atribuída a usuários cujo hash não pôde ser aproveitado
LEGACY_DEFAULT_PASSWORD=ProcertTrocar@2026
