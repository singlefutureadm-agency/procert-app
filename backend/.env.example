# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# `production` liga duas travas: o Swagger sai do ar (veja SWAGGER_ATIVO) e a
# aplicação recusa subir com o JWT_SECRET de exemplo abaixo.
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Origens liberadas no CORS (separadas por vírgula).
# Em produção, liste o domínio do SITE — não o da API. É o navegador do
# visitante que é barrado, e ele se identifica pela origem da página aberta.
#   CORS_ORIGINS=https://procertocp.com.br,https://www.procertocp.com.br
CORS_ORIGINS=http://localhost:5173

# Documentação interativa em /api/docs. Sem esta variável, segue a regra:
# ligada fora de produção, desligada em produção. Ela é um mapa completo da API
# servido sem autenticação — só ligue num ambiente publicado se souber por quê.
# SWAGGER_ATIVO=false

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ---------------------------------------------------------------------------
# Porta 5433, e não 5432: o container é mapeado 5433:5432 para conviver com uma
# instalação nativa de PostgreSQL na máquina. Com 5432 aqui, o primeiro comando
# do guia falha com `P1000: Authentication failed`.
DATABASE_URL="postgresql://procert:procert@localhost:5433/procert?schema=public"

# ---------------------------------------------------------------------------
# Autenticação
# Gere um segredo forte:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5
# URL pública onde os arquivos são servidos
PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Rotinas agendadas
# ---------------------------------------------------------------------------
# Expiração automática de certificados: todo dia às 03:00, marca como VENCIDO o
# que passou da validade. Ligada por padrão — uma instalação nova não deve
# exibir certificado vencido como se ainda valesse.
#
# Rodando a API em MAIS DE UMA instância, o job dispara em todas. É um
# `updateMany` idempotente, então não corrompe nada, mas deixe `true` em
# exatamente uma instância para não multiplicar conexão e log.
#
# A rota POST /certificados/expirar-vencidos continua disponível para
# acionamento manual, independentemente deste valor.
EXPIRACAO_CRON_ATIVA=true

# ---------------------------------------------------------------------------
# E-mail (SMTP) — usado na recuperação de senha
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM="ProCert <nao-responda@procertocp.com.br>"
# URL do frontend usada para montar o link de redefinição de senha
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# ETL — conexão com o MySQL legado (somente para `npm run migrate:legacy`)
# ---------------------------------------------------------------------------
LEGACY_MYSQL_HOST=
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_DATABASE=
# Senha provisória atribuída a usuários cujo hash não pôde ser aproveitado
LEGACY_DEFAULT_PASSWORD=ProcertTrocar@2026
