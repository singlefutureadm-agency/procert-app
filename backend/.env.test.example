# Ambiente do e2e (`npm run test:e2e`).
#
# Copie para `.env.test` — que NÃO é versionado — e ajuste se o seu banco
# estiver em outro lugar. O `.env.test.example` existe justamente para que o
# `.env.test` real, com credencial, fique fora do repositório.
#
# O banco é DEDICADO: `procert_test`, no mesmo container do desenvolvimento
# (porta 5433, não 5432 — o container é mapeado 5433:5432 para conviver com um
# PostgreSQL nativo em 5432). A suíte TRUNCA as tabelas entre arquivos, então
# apontar isto para o banco de desenvolvimento apaga os seus dados.
DATABASE_URL="postgresql://procert:procert@localhost:5433/procert_test?schema=public"

NODE_ENV=test
API_PREFIX=api

# Segredo fixo e óbvio: é ambiente de teste, e o token precisa ser reproduzível
# entre execuções. NUNCA reaproveite este valor em outro ambiente.
JWT_SECRET=segredo-apenas-para-testes-e2e
JWT_EXPIRES_IN=8h

# Custo baixo de propósito: o e2e cria vários usuários por execução e o custo 12
# de produção transformaria a fixture em dezenas de segundos. A compatibilidade
# $2y$ → $2b$ é coberta no unitário `senha.util.spec.ts`, com o custo real.
BCRYPT_SALT_ROUNDS=4

# Diretório próprio: o e2e escreve arquivos de verdade em `certificados/`,
# `certificacoes/`, `produtos/` e `aparencia/` para provar que o 404 das pastas
# privadas é negação, e não ausência de arquivo. Separar evita mexer nos uploads
# de desenvolvimento.
UPLOAD_DIR=./uploads-test
UPLOAD_MAX_SIZE_MB=5

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Sem rotina agendada no e2e: um @Cron ativo deixaria um timer aberto e o Jest
# reclamaria de handle vago no fim da suíte. A expiração automática tem teste
# próprio em `expiracao.cron.spec.ts`, e a rota manual é coberta aqui.
EXPIRACAO_CRON_ATIVA=false

# SMTP vazio: o MailService fica no modo [SIMULADO] e nenhum e-mail sai.
MAIL_HOST=
MAIL_USER=
MAIL_PASS=
