{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{dist,node_modules/.prisma}/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
