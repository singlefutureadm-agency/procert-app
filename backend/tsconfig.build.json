{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // `deleteOutDir` do nest-cli apaga dist/ a cada start; com build incremental
    // o tsc consultava o .tsbuildinfo, concluía que nada mudou e não emitia nada,
    // fazendo o start falhar com "Cannot find module dist/main".
    "incremental": false
  },
  // `src/testing` guarda mocks e fixtures usados só pelos `.spec.ts`; não tem
  // por que ir para o `dist/` de produção.
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "prisma",
    "src/testing",
    "**/*.spec.ts"
  ]
}
