// ---------------------------------------------------------------------------
// ProCert — modelo de dados PostgreSQL
//
// Migrado do MySQL legado (tbl_cliente, tbl_funcionario, tbl_produto,
// tbl_etapa_certificacao, tbl_certificacao_produto, tbl_certificacao_historico,
// tbl_pagamento, tbl_estado, tbl_reset_senha, tbl_contato).
//
// Mudanças estruturais em relação ao legado:
//  • Nomes normalizados (sem prefixo tbl_ e sem sufixo por entidade nas colunas)
//  • Status textuais viraram ENUMs
//  • `status_etapa` + `ativo_certificacao` (duplicados no legado) → único campo `ativo`
//  • Chaves estrangeiras reais com ON DELETE definido
//  • Unicidade de (produtoId, etapaId) em CertificacaoProduto
//  • Senhas sempre em hash bcrypt (`senhaHash`)
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------- ENUMS -------------------------------------

/// Papel do usuário. No legado: tbl_tipo_usuario.id_tipo (1, 2, 3).
enum Role {
  ADMIN // legado id_tipo_usuario = 1
  FUNCIONARIO // legado id_tipo_usuario = 2
  CLIENTE // legado id_tipo_usuario = 3
}

/// Substitui os textos 'Ativo' / 'Inativo' do legado.
enum StatusRegistro {
  ATIVO
  INATIVO
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

/// ENUM já existente no legado em tbl_certificacao_produto.status.
enum StatusCertificacao {
  PENDENTE
  EM_ANDAMENTO
  APROVADO
  REPROVADO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  CANCELADO
  ESTORNADO
}

/// Gravidade da não conformidade encontrada em uma etapa.
/// MAIOR compromete a conformidade do produto; MENOR admite correção pontual.
enum CriticidadeNaoConformidade {
  MENOR
  MAIOR
}

enum StatusNaoConformidade {
  ABERTA
  EM_TRATATIVA
  RESOLVIDA
  REPROVADA
}

enum StatusCertificado {
  EMITIDO
  SUSPENSO
  CANCELADO
  VENCIDO
}

/// Natureza técnica de uma etapa do processo de certificação.
enum TipoEtapa {
  DOCUMENTAL
  ENSAIO
  AUDITORIA_FABRICA
  ANALISE_CRITICA
  DECISAO
  OUTRO
}

/// Papel funcional na execução do processo.
///
/// **NÃO é papel de autenticação.** `Role` decide o que a pessoa alcança no
/// sistema (ADMIN, FUNCIONARIO, CLIENTE); este decide de quem é a etapa dentro
/// do fluxo de certificação. Um mesmo FUNCIONARIO pode ser TECNICO num processo
/// e QUALIDADE em outro — são eixos independentes, e cruzá-los transformaria
/// uma escala de trabalho em concessão de acesso.
///
/// Veio do quadro Trello da operação, onde o responsável era texto livre dentro
/// do item de checklist ("<etapa> <responsável> <SLA>").
enum PapelFuncional {
  CLIENTE
  TECNICO
  QUALIDADE
  AUDITOR
  DIRETORIA
}

/// Bloco do pipeline a que a etapa pertence — as "listas" do quadro Trello,
/// com o hand-off Técnico ↔ Qualidade que a operação já pratica.
///
/// A fase do PROCESSO é **derivada da etapa atual, nunca gravada no produto**.
/// No Trello a posição da lista e o progresso do checklist eram duas fontes de
/// verdade mantidas à mão, e divergiam; guardar a fase em `Produto` repetiria
/// exatamente esse defeito.
enum FaseProcesso {
  ABERTURA
  AMOSTRAGEM_AUDITORIA
  ENSAIOS_LABORATORIO
  ANALISE_PROCESSO
  EMISSAO
}

/// Por que este processo existe. Vinha no nome do card do Trello
/// (INICIAL / RENOVAÇÃO / RECERTIFICAÇÃO / MANUTENÇÃO / TRANSFERÊNCIA).
///
/// É atributo do processo, não da trilha: o mesmo produto pode voltar anos
/// depois para renovação seguindo a mesma régua técnica.
enum MotivoProcesso {
  INICIAL
  RENOVACAO
  RECERTIFICACAO
  MANUTENCAO
  TRANSFERENCIA
  EXTENSAO_ESCOPO
}

// ------------------------------ MODELOS ------------------------------------

/// Unidades federativas (legado: tbl_estado).
model Estado {
  id    Int    @id @default(autoincrement())
  sigla String @unique @db.Char(2)
  nome  String @db.VarChar(60)

  clientes     Cliente[]
  funcionarios Funcionario[]

  @@map("estados")
}

/// Empresa/pessoa que contrata a certificação (legado: tbl_cliente).
model Cliente {
  id             Int            @id @default(autoincrement())
  nome           String         @db.VarChar(150)
  email          String         @unique @db.VarChar(150)
  senhaHash      String         @map("senha_hash") @db.VarChar(255)
  tipoPessoa     TipoPessoa     @default(JURIDICA) @map("tipo_pessoa")
  cpf            String?        @db.VarChar(14)
  cnpj           String?        @db.VarChar(18)
  dataNascimento DateTime?      @map("data_nascimento") @db.Date
  telefone       String?        @db.VarChar(20)
  cep            String?        @db.VarChar(9)
  endereco       String?        @db.VarChar(255)
  bairro         String?        @db.VarChar(120)
  cidade         String?        @db.VarChar(120)
  estadoId       Int?           @map("estado_id")
  /// Funcionário responsável pela carteira desta empresa.
  ///
  /// Vínculo 1:N (um responsável por cliente), e não tabela pivô: a operação
  /// concentra cada empresa num ponto de contato. Se aparecer o caso real de
  /// substituição (férias, técnico + comercial), promova para N:N COM um campo
  /// `principal` — pivô sem ele deixa "quem responde por esta empresa" sem
  /// resposta única, que é justamente a pergunta que motivou o campo.
  ///
  /// **Hoje é informativo: não restringe acesso.** Nenhum service filtra por
  /// ele. Ao fechar o acesso por carteira, o `SetNull` abaixo vira decisão
  /// explícita — desativar um funcionário faria a carteira inteira dele sumir
  /// do painel de todo mundo, sem erro e sem aviso. Antes disso, exija
  /// transferência ou bloqueie a desativação.
  responsavelId  Int?           @map("responsavel_id")
  fotoUrl        String?        @map("foto_url") @db.VarChar(255)
  status         StatusRegistro @default(ATIVO)
  /// Último login BEM-SUCEDIDO desta conta.
  ///
  /// `Cliente` é a própria conta de acesso (tem `email` e `senhaHash` na
  /// linha), então a relação é 1:1 e este campo é o último login dela — não
  /// "do cliente". Credencial compartilhada entre várias pessoas da empresa
  /// não é distinguível aqui, e nenhum modelo distinguiria sem contas
  /// individuais por empresa.
  ///
  /// Responde "quem sumiu da plataforma". NÃO responde frequência de uso: para
  /// isso seria preciso uma tabela de eventos, deliberadamente não criada
  /// (custo de guarda e exposição de LGPD sem pergunta de negócio definida).
  ultimoAcessoEm DateTime?      @map("ultimo_acesso_em")
  criadoEm       DateTime       @default(now()) @map("criado_em")
  atualizadoEm   DateTime       @updatedAt @map("atualizado_em")

  estado      Estado?      @relation(fields: [estadoId], references: [id], onDelete: SetNull)
  responsavel Funcionario? @relation("CarteiraCliente", fields: [responsavelId], references: [id], onDelete: SetNull)
  produtos    Produto[]

  @@index([status])
  @@index([nome])
  @@index([responsavelId])
  @@map("clientes")
}

/// Equipe interna. Concentra ADMIN e FUNCIONARIO (legado: tbl_funcionario).
model Funcionario {
  id             Int            @id @default(autoincrement())
  nome           String         @db.VarChar(150)
  email          String         @unique @db.VarChar(150)
  senhaHash      String         @map("senha_hash") @db.VarChar(255)
  role           Role           @default(FUNCIONARIO)
  tipoPessoa     TipoPessoa     @default(FISICA) @map("tipo_pessoa")
  cpf            String?        @db.VarChar(14)
  cnpj           String?        @db.VarChar(18)
  dataNascimento DateTime?      @map("data_nascimento") @db.Date
  telefone       String?        @db.VarChar(20)
  cep            String?        @db.VarChar(9)
  endereco       String?        @db.VarChar(255)
  bairro         String?        @db.VarChar(120)
  cidade         String?        @db.VarChar(120)
  estadoId       Int?           @map("estado_id")
  fotoUrl        String?        @map("foto_url") @db.VarChar(255)
  status         StatusRegistro @default(ATIVO)
  /// Último login bem-sucedido. Mesma semântica do campo homônimo em `Cliente`.
  /// Aqui alimenta a coluna "última atividade" do relatório de equipe.
  ultimoAcessoEm DateTime?      @map("ultimo_acesso_em")
  criadoEm       DateTime       @default(now()) @map("criado_em")
  atualizadoEm   DateTime       @updatedAt @map("atualizado_em")

  estado                Estado?                  @relation(fields: [estadoId], references: [id], onDelete: SetNull)
  /// Clientes sob responsabilidade deste funcionário. Ver `Cliente.responsavelId`.
  carteira              Cliente[]                @relation("CarteiraCliente")
  historicoAlteracao    CertificacaoHistorico[]
  naoConformidades      NaoConformidade[]
  certificadosEmitidos  Certificado[]
  documentosEnviados    DocumentoCertificacao[]
  aparenciaAtualizada   ConfiguracaoAparencia[]
  microEtapasConcluidas MicroEtapaCertificacao[] @relation("MicroEtapaConcluida")
  processosCancelados   Produto[]                @relation("ProcessoCancelado")

  @@index([role, status])
  @@map("funcionarios")
}

/// Produto submetido à certificação (legado: tbl_produto).
model Produto {
  id                  Int            @id @default(autoincrement())
  clienteId           Int            @map("cliente_id")
  categoriaId         Int            @map("categoria_id")
  /// Versão da trilha vigente quando o produto foi submetido.
  /// É um retrato: não muda sozinha quando a categoria ganha uma versão nova.
  modeloTrilhaId      Int            @map("modelo_trilha_id")
  /// Identificador do processo no formato `PROCERT-<SIGLA>-<NNN>-<AA>`
  /// (ex.: `PROCERT-EPI-012-26`), sequencial POR ANO. É como a operação já
  /// chama cada processo — vinha no título do card do Trello.
  ///
  /// O sequencial é derivado do MAIOR código do ano, nunca de `COUNT`: contar
  /// linhas reemite um número já usado depois de uma exclusão. Mesma razão já
  /// registrada em `NaoConformidade.codigo` e `Certificado.numero`.
  ///
  /// Nulável e SEM backfill retroativo: inventar código para produto antigo
  /// criaria identificador que nunca circulou em documento nenhum. Produto
  /// anterior à mudança mostra "—".
  codigoProcesso      String?        @unique @map("codigo_processo") @db.VarChar(30)
  /// Por que este processo foi aberto. Ver `MotivoProcesso`.
  motivoProcesso      MotivoProcesso @default(INICIAL) @map("motivo_processo")
  /// Este processo aprova a etapa sozinho quando todas as microetapas dela são
  /// concluídas?
  ///
  /// **NULÁVEL de propósito, e `null` não é "não": é "herda".** `null` faz o
  /// produto seguir `ModeloTrilha.aprovacaoAutomatica` da versão que ele
  /// carrega. Um `Boolean` com default `false` não distinguiria "o admin
  /// desligou neste produto" de "o admin não opinou" — e só a segunda deve
  /// acompanhar a trilha quando a política da trilha mudar.
  ///
  /// Quem resolve os dois é `aprovacaoAutomaticaDoProduto()`. Nenhum lugar deve
  /// ler este campo cru para decidir.
  aprovacaoAutomatica Boolean?       @map("aprovacao_automatica")
  /// Quando o processo foi INTERROMPIDO. `null` = em andamento.
  ///
  /// **Não confundir com `status: INATIVO`.** São dois eixos:
  ///  • `status` é o soft delete do cadastro — o produto some das listagens.
  ///  • `canceladoEm` é um desfecho do PROCESSO: ele existiu, foi interrompido,
  ///    e continua visível no quadro, em coluna própria. Some do fluxo, não do
  ///    registro.
  ///
  /// É campo do produto, e não um `StatusCertificacao` novo, porque cancelar é
  /// decisão sobre o processo INTEIRO — as etapas mantêm o estado em que
  /// pararam, que é o que a auditoria precisa poder afirmar depois.
  ///
  /// A coluna CANCELADO do quadro deriva daqui. Nada é gravado sobre "em que
  /// fase estava quando parou", pelo mesmo motivo de sempre: seria uma segunda
  /// fonte de verdade envelhecendo ao lado da trilha.
  canceladoEm         DateTime?      @map("cancelado_em")
  /// Por que foi cancelado. Exigido pela ação: processo interrompido sem motivo
  /// registrado é uma pergunta sem resposta seis meses depois.
  motivoCancelamento  String?        @map("motivo_cancelamento") @db.Text
  /// Autoria desnormalizada, como as demais: sobrevive à exclusão do autor.
  canceladoPorId      Int?           @map("cancelado_por_id")
  canceladoPorNome    String?        @map("cancelado_por_nome") @db.VarChar(150)
  nome                String         @db.VarChar(150)
  descricao           String?        @db.Text
  preco               Decimal        @default(0) @db.Decimal(12, 2)
  fotoUrl             String?        @map("foto_url") @db.VarChar(255)
  status              StatusRegistro @default(ATIVO)
  criadoEm            DateTime       @default(now()) @map("criado_em")
  atualizadoEm        DateTime       @updatedAt @map("atualizado_em")

  cliente      Cliente               @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  categoria    CategoriaProduto      @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  modeloTrilha ModeloTrilha          @relation(fields: [modeloTrilhaId], references: [id], onDelete: Restrict)
  canceladoPor Funcionario?          @relation("ProcessoCancelado", fields: [canceladoPorId], references: [id], onDelete: SetNull)
  certificacao CertificacaoProduto[]
  certificados Certificado[]
  pagamentos   Pagamento[]

  @@index([clienteId])
  @@index([categoriaId])
  @@index([status])
  @@map("produtos")
}

/// Catálogo global de etapas do legado (tbl_etapa_certificacao).
///
/// OBSOLETO: substituído por CategoriaProduto → ModeloTrilha → ModeloEtapa.
/// Mantido apenas até `npm run migrate:categorias` transpor os dados; a relação
/// com CertificacaoProduto já foi cortada para permitir o remapeamento.
model EtapaCertificacao {
  id           Int      @id @default(autoincrement())
  nome         String   @unique @db.VarChar(120)
  descricao    String?  @db.Text
  ordem        Int
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([ordem])
  @@map("etapas_certificacao")
}

/// Família de produtos que compartilha o mesmo processo de certificação
/// (ex.: EPIs de altura, brinquedos, eletrodomésticos).
///
/// Existe porque a trilha de certificação não é universal: cada categoria
/// responde a normas, ensaios e documentos próprios.
model CategoriaProduto {
  id              Int            @id @default(autoincrement())
  nome            String         @unique @db.VarChar(120)
  /// Abreviação da categoria no código do processo (`EPI`, `VOL`, `AESC`).
  ///
  /// Nulável: categoria sem sigla não gera código — melhor um processo sem
  /// identificador que dois processos disputando o mesmo. Curta de propósito,
  /// para o código caber onde a operação já o escreve à mão.
  sigla           String?        @db.VarChar(8)
  descricao       String?        @db.Text
  normaReferencia String?        @map("norma_referencia") @db.VarChar(200)
  /// Validade do certificado emitido para produtos desta categoria, em meses.
  /// Varia por família (EPI, brinquedo, eletrodoméstico) e por norma.
  validadeMeses   Int            @default(24) @map("validade_meses")
  status          StatusRegistro @default(ATIVO)
  /// Trilha do catálogo que esta categoria segue.
  ///
  /// Nulável: categoria recém-criada ainda não tem trilha, e sem trilha ela não
  /// aceita produto — a regra vive em `ModelosTrilhaService.resolverVigente`.
  /// Aponta para a FAMÍLIA, não para a versão: qual versão vale hoje é a que
  /// estiver `ativo`, e trocar de versão não mexe nesta coluna.
  trilhaId        Int?           @map("trilha_id")
  criadoEm        DateTime       @default(now()) @map("criado_em")
  atualizadoEm    DateTime       @updatedAt @map("atualizado_em")

  trilha   Trilha?   @relation(fields: [trilhaId], references: [id], onDelete: Restrict)
  produtos Produto[]

  @@index([status])
  @@index([trilhaId])
  @@map("categorias_produto")
}

/// Trilha de certificação do catálogo — a FAMÍLIA, não a versão.
///
/// Existe como cadastro próprio para poder ser reaproveitada: "Ensaio +
/// auditoria" é desenhada uma vez e vinculada a quantas categorias precisarem.
/// Antes a trilha pertencia a uma categoria (`ModeloTrilha.categoriaId`), o que
/// obrigava a redigitar o mesmo processo a cada categoria nova e fazia duas
/// categorias com o mesmo processo divergirem em silêncio na primeira revisão.
///
/// A família guarda identidade e nome; o processo em si vive nas VERSÕES
/// (`ModeloTrilha`), que continuam imutáveis assim que têm produto vinculado.
model Trilha {
  id           Int            @id @default(autoincrement())
  nome         String         @unique @db.VarChar(120)
  descricao    String?        @db.Text
  status       StatusRegistro @default(ATIVO)
  criadoEm     DateTime       @default(now()) @map("criado_em")
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")

  versoes    ModeloTrilha[]
  categorias CategoriaProduto[]

  @@index([status])
  @@map("trilhas")
}

/// Versão imutável de uma trilha do catálogo.
///
/// Trilhas mudam com o tempo (norma revisada, ensaio novo), mas um produto já
/// submetido precisa ser avaliado pelas regras vigentes na submissão. Por isso
/// versiona-se em vez de editar: só a versão sem produtos vinculados é editável.
///
/// `Produto.modeloTrilhaId` aponta para AQUI, não para `Trilha`: é o retrato da
/// versão vigente no dia da submissão. Vincular a categoria a outra trilha, ou
/// publicar uma versão nova, não mexe em produto nenhum já em andamento.
model ModeloTrilha {
  id                  Int       @id @default(autoincrement())
  trilhaId            Int       @map("trilha_id")
  versao              Int
  ativo               Boolean   @default(true)
  /// Padrão do processo: concluir todas as microetapas de uma etapa a aprova
  /// sozinha?
  ///
  /// Fica na VERSÃO, e não na família `Trilha`, pela mesma razão que tudo mais
  /// aqui: o produto guarda `modeloTrilhaId` como retrato, então herda a regra
  /// vigente na submissão. Na família, virar esta chave mudaria em silêncio o
  /// modo de aprovar de todo processo em andamento — inclusive os que já
  /// estavam sendo avaliados sob a regra anterior.
  ///
  /// `Produto.aprovacaoAutomatica` sobrepõe isto caso a caso.
  ///
  /// Default `false`: aprovação de etapa de certificação é ato humano com
  /// autoria, e ligar automação por omissão seria decidir isso pelo cliente.
  aprovacaoAutomatica Boolean   @default(false) @map("aprovacao_automatica")
  vigenteDe           DateTime  @default(now()) @map("vigente_de")
  vigenteAte          DateTime? @map("vigente_ate")
  criadoEm            DateTime  @default(now()) @map("criado_em")

  trilha   Trilha        @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  etapas   ModeloEtapa[]
  produtos Produto[]

  @@unique([trilhaId, versao])
  @@index([trilhaId, ativo])
  @@map("modelos_trilha")
}

/// Etapa prevista por uma versão de trilha.
model ModeloEtapa {
  id               Int             @id @default(autoincrement())
  modeloTrilhaId   Int             @map("modelo_trilha_id")
  nome             String          @db.VarChar(120)
  descricao        String?         @db.Text
  ordem            Int
  tipo             TipoEtapa       @default(OUTRO)
  obrigatoria      Boolean         @default(true)
  /// Prazo alvo da etapa, em HORAS.
  ///
  /// Era `prazoSlaDias` até 05/09/2026. A operação trabalha em horas — o quadro
  /// da Qualidade fala em 8h, 12h, 24h, 72h —, e "1 dia" não representa isso:
  /// arredondar 8h para 1 dia e 72h para 3 dias apaga justamente a diferença
  /// que o prazo existe para cobrar. A migration converteu o que havia
  /// (`prazo_sla_dias * 24`) antes de derrubar a coluna antiga.
  ///
  /// Nulável: etapa sem prazo acordado não deve exibir prazo nenhum.
  prazoSlaHoras    Int?            @map("prazo_sla_horas")
  /// De quem é esta etapa no fluxo. Papel FUNCIONAL, não de acesso — ver
  /// `PapelFuncional`.
  ///
  /// Nulável porque as etapas já cadastradas não têm responsável definido e
  /// ninguém pode adivinhar qual seria. Um default aqui inventaria dado.
  papelResponsavel PapelFuncional? @map("papel_responsavel")
  /// Bloco do pipeline em que esta etapa aparece no quadro.
  ///
  /// Tem default (e não é nulável) para que a migration não trave numa base com
  /// dados e para que nenhuma etapa fique fora do quadro: sem coluna atribuída,
  /// o cartão simplesmente sumiria da tela em vez de aparecer no lugar errado —
  /// um processo invisível é pior que um processo mal classificado.
  fase             FaseProcesso    @default(ABERTURA)
  exigeDocumento   Boolean         @default(false) @map("exige_documento")

  modeloTrilha  ModeloTrilha          @relation(fields: [modeloTrilhaId], references: [id], onDelete: Cascade)
  certificacoes CertificacaoProduto[]
  microEtapas   ModeloMicroEtapa[]

  @@index([modeloTrilhaId, ordem])
  @@map("modelos_etapa")
}

/// Microetapa prevista por uma etapa da versão de trilha — o item de checklist.
///
/// Vive na TRILHA, não no produto: é parte da definição do processo, e portanto
/// imutável junto com a versão. O que o produto carrega é uma CÓPIA
/// (`MicroEtapaCertificacao`), feita na abertura da trilha, exatamente como
/// `CertificacaoProduto.ordem` é cópia de `ModeloEtapa.ordem`.
///
/// Sem texto próprio de "descrição": um item de checklist que precisa de
/// parágrafo explicativo é uma etapa, não uma microetapa.
model ModeloMicroEtapa {
  id               Int             @id @default(autoincrement())
  modeloEtapaId    Int             @map("modelo_etapa_id")
  nome             String          @db.VarChar(200)
  ordem            Int
  /// Área responsável por ESTE item, quando difere da responsável pela etapa.
  ///
  /// Nulável, e o `null` significa "a mesma da etapa" — não "ninguém". Uma
  /// etapa de ensaio pode ter o recebimento da amostra com a Qualidade e a
  /// execução com o Técnico; quando não há essa divisão, repetir o papel da
  /// etapa em todos os itens seria ruído.
  papelResponsavel PapelFuncional? @map("papel_responsavel")
  /// Prazo alvo DESTE item, em horas. Nulável: item sem prazo próprio.
  ///
  /// É independente do prazo da etapa e não o substitui: a etapa continua com
  /// o SLA dela, que é o que o quadro cobra. Este aqui detalha o trabalho
  /// interno, e a soma dos itens NÃO precisa fechar com o prazo da etapa —
  /// forçar isso transformaria uma estimativa em restrição.
  prazoSlaHoras    Int?            @map("prazo_sla_horas")

  modeloEtapa ModeloEtapa              @relation(fields: [modeloEtapaId], references: [id], onDelete: Cascade)
  copias      MicroEtapaCertificacao[]

  @@index([modeloEtapaId, ordem])
  @@map("modelos_micro_etapa")
}

/// Uma etapa aplicada a um produto (legado: tbl_certificacao_produto).
/// `etapaId` aponta para `ModeloEtapa` — a etapa da versão de trilha que o
/// produto carrega —, não mais para o catálogo global.
model CertificacaoProduto {
  id           Int                @id @default(autoincrement())
  produtoId    Int                @map("produto_id")
  etapaId      Int                @map("etapa_id")
  /// Posição desta etapa na trilha DO PRODUTO.
  ///
  /// Copiada de `ModeloEtapa.ordem` na abertura da trilha. É um campo próprio
  /// porque um produto migrado de versão carrega etapas de modelos diferentes,
  /// cujos `ordem` colidem — a sequência real só existe no nível do produto.
  ordem        Int
  status       StatusCertificacao @default(PENDENTE)
  observacao   String?            @db.Text
  /// Quando o trabalho nesta etapa começou — 1ª saída de `PENDENTE`.
  ///
  /// **Cache do que `CertificacaoHistorico` já sabe. O histórico continua sendo
  /// a fonte de verdade** (é ele que `relatorios/ciclo.service.ts` lê, e que
  /// segue mandando em todo número publicado). Estes dois campos existem porque
  /// o quadro precisa do prazo de cada etapa em N processos ao mesmo tempo, e
  /// derivar isso do histórico a cada carga é varredura de tabela por cartão.
  ///
  /// DEFINIÇÃO — repetida verbatim no SQL das migrations de backfill e em
  /// `CertificacoesService.salvar()`. Duas definições divergiriam para sempre,
  /// porque nada as compararia em execução:
  ///
  ///   iniciadaEm = MIN(alterado_em) do histórico da etapa
  ///                WHERE status_anterior = 'PENDENTE'
  ///                  AND status_novo    <> 'PENDENTE'
  ///
  /// **MONOTÔNICO: grave apenas quando estiver null, nunca sobrescreva.** É o
  /// mesmo marco que `ciclo.service.ts` publica como "tempo em fila"; movê-lo
  /// mudaria número de relatório já divulgado. Etapa reaberta por não
  /// conformidade mantém o início ORIGINAL.
  ///
  /// `criadoEm` NÃO serve para isto: é a entrada na FILA. A trilha nasce num
  /// `createMany` dentro da transação do produto e, em Postgres,
  /// `CURRENT_TIMESTAMP` é o início da transação — todas as etapas de um
  /// produto nascem com o mesmo timestamp, igual ao do produto.
  iniciadaEm   DateTime?          @map("iniciada_em")
  /// Quando esta etapa foi aprovada — a aprovação VIGENTE.
  ///
  ///   concluidaEm = alterado_em da aprovação vigente, isto é
  ///                 MAX(alterado_em) WHERE status_novo = 'APROVADO'
  ///                 -- e NULL se a etapa hoje não está APROVADO
  ///
  /// **REVERSÍVEL, ao contrário de `iniciadaEm`: grave ao aprovar e LIMPE em
  /// toda saída de `APROVADO`.** Os dois campos têm naturezas opostas de
  /// propósito, e tratá-los com a mesma regra quebra um dos dois.
  ///
  /// É MAX, não MIN. Uma etapa aprovada → reprovada (não conformidade) →
  /// aprovada de novo tem a conclusão vigente na ÚLTIMA aprovação; MIN
  /// devolveria a primeira, e o backfill nasceria discordando do `salvar()`
  /// exatamente nos casos em que a diferença importa.
  ///
  /// Os caminhos que saem de `APROVADO` são dois, e ambos limpam o campo dentro
  /// da transação que já existe: `CertificacoesService.salvar()` (reprovação ou
  /// volta para EM_ANDAMENTO) e `NaoConformidadesService.avaliar()` (NC
  /// resolvida devolve a etapa para reavaliação). A invariante está no banco,
  /// em `ck_certificacao_concluida_em` — se um caminho novo escapar, ele falha
  /// na hora em vez de deixar o quadro afirmar conclusão que o status nega.
  ///
  /// CONSEQUÊNCIA ASSUMIDA: etapa reaberta conta o SLA desde a entrada
  /// original, então aparece estourada no quadro. É o lado seguro do erro —
  /// um terceiro relógio ("tempo desde a reabertura") é exatamente o "tempo da
  /// etapa" genérico que este projeto recusa. Pendente de confirmação da
  /// Qualidade.
  concluidaEm  DateTime?          @map("concluida_em")
  criadoEm     DateTime           @default(now()) @map("criado_em")
  atualizadoEm DateTime           @updatedAt @map("atualizado_em")

  produto          Produto                  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  etapa            ModeloEtapa              @relation(fields: [etapaId], references: [id], onDelete: Restrict)
  historico        CertificacaoHistorico[]
  naoConformidades NaoConformidade[]
  microEtapas      MicroEtapaCertificacao[]

  @@unique([produtoId, etapaId])
  @@index([produtoId, ordem])
  @@index([status])
  @@map("certificacoes_produto")
}

/// A microetapa aplicada a um produto — o item de checklist que se marca.
///
/// Cópia de `ModeloMicroEtapa`, feita na abertura da trilha e na migração de
/// versão. O `nome` é copiado, e não lido por FK, pelo mesmo motivo das autorias
/// desnormalizadas: o texto do checklist que a pessoa marcou precisa sobreviver
/// a qualquer mudança de catálogo. `modeloMicroEtapaId` fica só como rastro da
/// origem, e é `SetNull`.
///
/// **Marcar todas NÃO aprova a etapa por si.** A aprovação automática é um
/// efeito do ATO de marcar a última — decidido em
/// `MicroEtapasService.alternar` — e nunca um estado derivado. A diferença
/// importa: derivada, uma etapa reaberta por não conformidade (que volta a
/// EM_ANDAMENTO com todos os itens ainda marcados) se reaprovaria sozinha, e a
/// reavaliação que a NC existe para forçar nunca aconteceria.
model MicroEtapaCertificacao {
  id                 Int             @id @default(autoincrement())
  certificacaoId     Int             @map("certificacao_id")
  /// Origem no catálogo. Só rastro: o texto exibido é o `nome` desta linha.
  modeloMicroEtapaId Int?            @map("modelo_micro_etapa_id")
  nome               String          @db.VarChar(200)
  ordem              Int
  /// Copiados do catálogo junto com o nome, pelo mesmo motivo dele: o item que
  /// a pessoa marcou precisa preservar sob qual responsável e qual prazo foi
  /// executado, mesmo que o catálogo mude depois.
  papelResponsavel   PapelFuncional? @map("papel_responsavel")
  prazoSlaHoras      Int?            @map("prazo_sla_horas")
  concluida          Boolean         @default(false)
  concluidaEm        DateTime?       @map("concluida_em")
  /// Autoria vem da sessão. Desnormalizada, como as demais: sobrevive à
  /// exclusão do colaborador.
  concluidaPorId     Int?            @map("concluida_por_id")
  concluidaPorNome   String?         @map("concluida_por_nome") @db.VarChar(150)
  criadoEm           DateTime        @default(now()) @map("criado_em")

  certificacao     CertificacaoProduto @relation(fields: [certificacaoId], references: [id], onDelete: Cascade)
  modeloMicroEtapa ModeloMicroEtapa?   @relation(fields: [modeloMicroEtapaId], references: [id], onDelete: SetNull)
  concluidaPor     Funcionario?        @relation("MicroEtapaConcluida", fields: [concluidaPorId], references: [id], onDelete: SetNull)

  @@index([certificacaoId, ordem])
  @@map("micro_etapas_certificacao")
}

/// Não conformidade levantada na avaliação de uma etapa.
///
/// Existe para que uma reprovação deixe de ser um status com observação em
/// texto livre e passe a ser um registro rastreável: o que foi encontrado, com
/// que gravidade, até quando o cliente tem para responder e o que ele
/// respondeu. A resolução reabre a etapa para reavaliação.
model NaoConformidade {
  id              Int                        @id @default(autoincrement())
  certificacaoId  Int                        @map("certificacao_id")
  /// Sequencial por ano no formato NC-2026-000123.
  codigo          String                     @unique @db.VarChar(20)
  descricao       String                     @db.Text
  criticidade     CriticidadeNaoConformidade
  status          StatusNaoConformidade      @default(ABERTA)
  prazoResposta   DateTime?                  @map("prazo_resposta")
  respostaCliente String?                    @map("resposta_cliente") @db.Text
  respondidoEm    DateTime?                  @map("respondido_em")
  /// Parecer da equipe ao avaliar a resposta.
  parecer         String?                    @db.Text
  abertoPorId     Int?                       @map("aberto_por_id")
  /// Desnormalizado: a autoria sobrevive à exclusão do colaborador.
  abertoPorNome   String                     @map("aberto_por_nome") @db.VarChar(150)
  resolvidoEm     DateTime?                  @map("resolvido_em")
  criadoEm        DateTime                   @default(now()) @map("criado_em")
  atualizadoEm    DateTime                   @updatedAt @map("atualizado_em")

  certificacao CertificacaoProduto @relation(fields: [certificacaoId], references: [id], onDelete: Cascade)
  abertoPor    Funcionario?        @relation(fields: [abertoPorId], references: [id], onDelete: SetNull)

  @@index([certificacaoId])
  @@index([status, prazoResposta])
  @@map("nao_conformidades")
}

/// Trilha de auditoria imutável (legado: tbl_certificacao_historico).
model CertificacaoHistorico {
  id              Int                 @id @default(autoincrement())
  certificacaoId  Int                 @map("certificacao_id")
  statusAnterior  StatusCertificacao? @map("status_anterior")
  statusNovo      StatusCertificacao  @map("status_novo")
  observacao      String?             @db.Text
  alteradoPorId   Int?                @map("alterado_por_id")
  alteradoPorNome String              @map("alterado_por_nome") @db.VarChar(150)
  alteradoEm      DateTime            @default(now()) @map("alterado_em")

  certificacao CertificacaoProduto     @relation(fields: [certificacaoId], references: [id], onDelete: Cascade)
  alteradoPor  Funcionario?            @relation(fields: [alteradoPorId], references: [id], onDelete: SetNull)
  documentos   DocumentoCertificacao[]

  @@index([certificacaoId, alteradoEm])
  @@map("certificacoes_historico")
}

/// Evidência anexada a uma etapa (laudo de ensaio, relatório de auditoria,
/// memorial descritivo).
///
/// Pendura em `CertificacaoHistorico`, e não em `CertificacaoProduto`, para
/// preservar o momento: fica registrado em qual ponto da trilha — e por quem —
/// cada documento entrou. Um anexo enviado antes da aprovação gera o seu
/// próprio registro de histórico, de modo que todo arquivo tem data e autoria.
model DocumentoCertificacao {
  id             Int      @id @default(autoincrement())
  historicoId    Int      @map("historico_id")
  /// Nome original enviado pelo usuário, só para exibição/download.
  nomeArquivo    String   @map("nome_arquivo") @db.VarChar(255)
  /// Caminho relativo em /uploads (nome real é um UUID).
  arquivoUrl     String   @map("arquivo_url") @db.VarChar(255)
  tipoMime       String   @map("tipo_mime") @db.VarChar(100)
  tamanhoBytes   Int      @map("tamanho_bytes")
  enviadoPorId   Int?     @map("enviado_por_id")
  enviadoPorNome String   @map("enviado_por_nome") @db.VarChar(150)
  criadoEm       DateTime @default(now()) @map("criado_em")

  historico  CertificacaoHistorico @relation(fields: [historicoId], references: [id], onDelete: Cascade)
  enviadoPor Funcionario?          @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)

  @@index([historicoId])
  @@map("documentos_certificacao")
}

/// Certificado de conformidade emitido para um produto.
///
/// É o produto final do processo e um documento com efeito externo: por isso
/// número imutável, validade explícita e um status próprio — suspender ou
/// cancelar um certificado é diferente de mexer na trilha que o originou.
model Certificado {
  id        Int    @id @default(autoincrement())
  produtoId Int    @map("produto_id")
  /// Sequencial por ano: PROCERT-2026-000045.
  numero    String @unique @db.VarChar(30)
  /// O que exatamente está certificado (modelo, variante, faixa de aplicação).
  escopo    String @db.Text

  dataEmissao  DateTime          @default(now()) @map("data_emissao")
  dataValidade DateTime          @map("data_validade")
  status       StatusCertificado @default(EMITIDO)
  /// Obrigatório em suspensão e cancelamento.
  motivoStatus String?           @map("motivo_status") @db.Text

  emitidoPorId   Int?     @map("emitido_por_id")
  /// Desnormalizado: a autoria sobrevive à exclusão do colaborador.
  emitidoPorNome String   @map("emitido_por_nome") @db.VarChar(150)
  /// Caminho relativo em /uploads. Regenerável a partir dos dados do registro.
  arquivoPdf     String?  @map("arquivo_pdf") @db.VarChar(255)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  produto    Produto      @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  emitidoPor Funcionario? @relation(fields: [emitidoPorId], references: [id], onDelete: SetNull)

  @@index([produtoId, dataEmissao])
  @@index([status, dataValidade])
  @@map("certificados")
}

/// Pagamentos do processo (legado: tbl_pagamento — antes só era lido).
model Pagamento {
  id            Int             @id @default(autoincrement())
  produtoId     Int             @map("produto_id")
  valor         Decimal         @default(0) @db.Decimal(12, 2)
  status        StatusPagamento @default(PENDENTE)
  dataPagamento DateTime?       @map("data_pagamento")
  observacao    String?         @db.Text
  criadoEm      DateTime        @default(now()) @map("criado_em")
  atualizadoEm  DateTime        @updatedAt @map("atualizado_em")

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, criadoEm])
  @@map("pagamentos")
}

/// Token de redefinição de senha (legado: tbl_reset_senha).
/// Diferença: guarda o HASH do token, não o token em claro.
model TokenRedefinicaoSenha {
  id        Int       @id @default(autoincrement())
  email     String    @db.VarChar(150)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  @@index([email])
  @@map("tokens_redefinicao_senha")
}

/// Mensagens do formulário público (legado: tbl_contato).
model MensagemContato {
  id       Int      @id @default(autoincrement())
  nome     String   @db.VarChar(150)
  email    String   @db.VarChar(150)
  telefone String?  @db.VarChar(20)
  assunto  String   @db.VarChar(200)
  mensagem String   @db.Text
  lida     Boolean  @default(false)
  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("mensagens_contato")
}

/// Qual dos dois conjuntos de tokens o painel usa quando o usuário nunca escolheu.
enum TemaPadrao {
  CLARO
  ESCURO
}

/// Design tokens do painel, editáveis pelo ADMIN em /dashboard/aparencia.
///
/// Linha única (id fixo em 1): é configuração global do organismo, não
/// preferência por usuário — o que o admin salva vale para todo mundo.
/// Se a linha não existir, o service serve os defaults do `global.css`,
/// então uma instalação nova funciona sem seed.
///
/// Os tokens ficam em `Json` para não exigir migration a cada token novo.
/// A segurança disso não vem da coluna e sim do DTO: `TokensTemaDto` é uma
/// allowlist fechada de chaves, cada uma com regex de cor ou faixa numérica,
/// e o ValidationPipe global roda com `forbidNonWhitelisted`. Json livre aqui
/// seria injeção de CSS direto no `style` do documento.
model ConfiguracaoAparencia {
  id                  Int        @id @default(1)
  temaClaro           Json       @map("tema_claro")
  temaEscuro          Json       @map("tema_escuro")
  /// Id do catálogo de fontes, não a pilha CSS (ver `aparencia.defaults.ts`).
  fonte               String     @db.VarChar(60)
  temaPadrao          TemaPadrao @default(ESCURO) @map("tema_padrao")
  /// Se false, o usuário fica travado em `temaPadrao` e o botão some do topo.
  permitirAlternancia Boolean    @default(true) @map("permitir_alternancia")

  /// Logo da sidebar quando o painel está no tema CLARO — fundo claro, então
  /// prefira traço escuro. Vazia, cai para `logoTemaEscuroUrl`.
  logoTemaClaroUrl     String?  @map("logo_tema_claro_url") @db.VarChar(255)
  /// Logo da sidebar no tema ESCURO (prefira traço claro) e SEMPRE a do
  /// cabeçalho do site público, cujo hero é escuro nos dois modos. Vazia, cai
  /// para `logoTemaClaroUrl`: o fallback é cruzado nos dois sentidos, para que
  /// quem envie uma logo só continue com marca nos dois temas.
  logoTemaEscuroUrl    String?  @map("logo_tema_escuro_url") @db.VarChar(255)
  /// Imagem de fundo do painel. Global aos dois modos.
  papelParedeUrl       String?  @map("papel_parede_url") @db.VarChar(255)
  /// 0–100. Em 0 o papel de parede some sem perder o arquivo enviado.
  papelParedeOpacidade Int      @default(35) @map("papel_parede_opacidade")
  /// COBRIR | CONTER | REPETIR
  papelParedeAjuste    String   @default("COBRIR") @map("papel_parede_ajuste") @db.VarChar(20)
  atualizadoPorId      Int?     @map("atualizado_por_id")
  atualizadoEm         DateTime @updatedAt @map("atualizado_em")

  atualizadoPor Funcionario? @relation(fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("configuracao_aparencia")
}
